amends "../../schema/Definitions.pkl"

import "../../schema/Types.pkl"
import "../../schema/Definitions.pkl"
import "../../schema/Citations.pkl"

package = new Types.PackageMetadata {
  id = "axioval:example.definitions"
  name = new Types.LocalizedText {
    default = "Example definitions"
    translations { ["de"] = "Beispieldefinitionen" }
  }
  version = "0.1.0"
  description = new Types.LocalizedText {
    default = "Non-production terminology used by the schema examples."
    translations { ["de"] = "Nicht produktive Terminologie für die Schemabeispiele." }
  }
  repository = "https://github.com/axioval/schema"
}

sources {
  ["https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/"] = new Citations.Source {
    id = "https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/"
    kind = "technicalSpecification"
    designation = "IFC 4.3"
    title = new Types.LocalizedText {
      default = "Industry Foundation Classes 4.3"
      translations { ["de"] = "Industry Foundation Classes 4.3" }
    }
    publisher = "buildingSMART International"
    edition = "4.3"
    url = "https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/"
  }
}

objectTypes {
  ["axioval:example.ifc.wall"] = new Definitions.ObjectTypeDefinition {
    id = "axioval:example.ifc.wall"
    name = new Types.LocalizedText { default = "Wall" }
    externalNames {
      new Definitions.ExternalName {
        typeSystem = "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3"
        name = "IfcWall"
      }
    }
    citations {
      new Citations.Citation {
        id = "ifc-wall-definition"
        sourceId = "https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/"
        locators { new Citations.Locator { kind = "section"; value = "IfcWall" } }
      }
    }
  }
}

properties {
  ["axioval:example.ifc.reference"] = new Definitions.PropertyDefinition {
    id = "axioval:example.ifc.reference"
    name = new Types.LocalizedText { default = "Reference" }
    valueKind = "string"
    externalNames {
      new Definitions.ExternalName {
        typeSystem = "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3"
        name = "Reference"
      }
    }
    citations {
      new Citations.Citation {
        id = "wall-reference-property"
        sourceId = "https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/"
        locators { new Citations.Locator { kind = "section"; value = "Pset_WallCommon.Reference" } }
      }
    }
  }
}

propertySets {
  ["axioval:example.ifc.pset-wall-common"] = new Definitions.PropertySetDefinition {
    id = "axioval:example.ifc.pset-wall-common"
    name = new Types.LocalizedText { default = "Pset_WallCommon" }
    externalNames {
      new Definitions.ExternalName {
        typeSystem = "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3"
        name = "Pset_WallCommon"
      }
    }
    citations {
      new Citations.Citation {
        id = "wall-common-property-set"
        sourceId = "https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/"
        locators { new Citations.Locator { kind = "section"; value = "Pset_WallCommon" } }
      }
    }
  }
}

definitions {
  ["axioval:example.property-exists"] = new Definitions.RuleDefinition {
    id = "axioval:example.property-exists"
    name = new Types.LocalizedText {
      default = "Required property"
    }
    description = new Types.LocalizedText {
      default = "Checks that a typed property exists on selected entities."
    }
    capability = "axioval:capability.property-exists"
    parameters {
      ["property"] = new Definitions.ParameterDefinition {
        id = "property"
        name = new Types.LocalizedText { default = "Property reference" }
        kind = "propertyReference"
      }
    }
    tags {
      "example"
      "property"
    }
  }
}
