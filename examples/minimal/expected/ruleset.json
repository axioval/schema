{
  "schemaVersion": "0.1.0",
  "package": {
    "id": "axioval:example.ruleset",
    "name": "Example ruleset",
    "version": "0.1.0",
    "description": "Non-production example of a modular Axioval ruleset.",
    "repository": "https://github.com/axioval/schema",
    "authors": []
  },
  "definitionPackages": [
    "axioval:example.definitions"
  ],
  "root": {
    "id": "root",
    "name": {
      "default": "Example checks",
      "translations": {}
    },
    "rules": [
      {
        "id": "wall-reference-required",
        "definitionId": "axioval:example.property-exists",
        "name": {
          "default": "Walls require a reference",
          "translations": {}
        },
        "enabled": true,
        "severity": "error",
        "parameters": {
          "propertySet": {
            "type": "string",
            "value": "Pset_WallCommon"
          },
          "property": {
            "type": "string",
            "value": "Reference"
          }
        },
        "applicability": {
          "kind": "entityType",
          "typeSystem": "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3",
          "typeName": "IfcWall",
          "includeSubtypes": true
        },
        "tags": [
          "example"
        ]
      }
    ],
    "folders": []
  }
}
