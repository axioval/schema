    "rules": [
      {
        "id": "wall-to-pipe-clearance",
        "definitionId": "axioval:example.geometry.directional-clearance",
        "name": {
          "default": "Walls and pipes keep 200 mm clearance",
          "translations": {}
        },
        "enabled": true,
        "severity": "error",
