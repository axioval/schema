/// Proves MCS lowers package-owned IFC and geometry references without copying vocabularies.
module axioval.tests.adapters

amends "pkl:test"

import "pkl:test" as test

import "@geometry/capabilities/Catalog.pkl" as geometryCatalog
import "@ifc/ifc.pkl" as ifc
import "@ifc/versions/Ifc2x3.pkl" as ifc2x3
import "@ifc/versions/Ifc4.pkl" as ifc4
import "@ifc/versions/Ifc4x3.pkl" as ifc4x3

import "../../schema/adapters/Geometry.pkl" as geometryAdapter
import "../../schema/adapters/Ifc.pkl" as ifcAdapter

facts {
  ["all supported IFC releases stay explicit"] {
    ifc2x3.entity("IfcWall").release == "IFC2X3_TC1"
    ifc4.entity("IfcWall").release == "IFC4_ADD2_TC1"
    ifc4x3.entity("IfcWall").release == "IFC4X3_ADD2"
    ifc2x3.release.externalTypeSystem != ifc4.release.externalTypeSystem
    ifc4.release.externalTypeSystem != ifc4x3.release.externalTypeSystem
  }

  ["normalized IFC identity is semantic, release-bound, and transport-neutral"] {
    ifc2x3.release.externalTypeSystem
      == "https://standards.buildingsmart.org/IFC/RELEASE/IFC2x3/TC1/HTML/"
    ifc4.release.externalTypeSystem
      == "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4"
    ifc4x3.release.externalTypeSystem
      == "https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3"
    ifc4x3.release.packageCatalogUri != ifc4x3.release.externalTypeSystem
    let (ifc4Name = ifcAdapter.entityExternalName(ifc4.entity("IfcWall")))
    let (ifc4x3Name = ifcAdapter.entityExternalName(ifc4x3.entity("IfcWall")))
      ifc4Name.name == "IfcWall"
        && ifc4Name.typeSystem == ifc4.release.externalTypeSystem
        && ifc4x3Name.name == "IfcWall"
        && ifc4x3Name.typeSystem == ifc4x3.release.externalTypeSystem
        && ifc4Name.typeSystem != ifc4x3Name.typeSystem
  }

  ["IFC entity references lower to MCS external names"] {
    let (externalName = ifcAdapter.entityExternalName(ifc4x3.entity("IfcWall")))
      externalName.typeSystem == ifc4x3.release.externalTypeSystem
        && externalName.name == "IfcWall"
  }

  ["IFC template identity remains omitted until package-owned occurrences ship"] {
    ifc.templateCatalogExtension.status == "not-bundled"
    ifc.templateCatalogExtension.occurrenceIdentity == "release-local"
    ifc.templateCatalogExtension.continuityPolicy == "explicit-evidence-required"
  }

  ["geometry capability remains owned and closed by its package"] {
    geometryCatalog.allCapabilities.contains("openbim.geometry:clearance.directional")
    geometryAdapter.capability("openbim.geometry:clearance.directional")
      == "openbim.geometry:clearance.directional"
  }
}
